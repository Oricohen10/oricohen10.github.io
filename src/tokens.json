{
  "$meta": {
    "source": "Verint Color Semantics (Color Semantics > text.*)",
    "applied_to": "tokens.css",
    "note": "Resolved hex values. Dark mode values derived by inverting the Verint grey scale."
  },
  "text": {
    "neutral": {
      "main": {
        "light": "#121213",
        "dark": "#f3f4f5",
        "css_var": "--text-primary",
        "legacy_alias": "--tx",
        "description": "Primary text — headings, body"
      },
      "subtext": {
        "light": "#585b5e",
        "dark": "#d0d3d6",
        "css_var": "--text-secondary",
        "legacy_alias": "--tx2",
        "description": "Secondary text — labels, captions"
      },
      "placeholder": {
        "light": "#6a6d70",
        "dark": "#8d9296",
        "css_var": "--text-tertiary",
        "legacy_alias": "--tx3",
        "description": "Tertiary text — placeholders, metadata, hint text"
      }
    },
    "brand": {
      "regular": {
        "light": "#0882d4",
        "dark": "#4daefb",
        "css_var": "--text-brand",
        "legacy_alias": "--tx-brand",
        "description": "Brand/link text (text.brand.regular)"
      }
    },
    "common": {
      "disabled": {
        "light": "#b0b6bb",
        "dark": "#585b5e",
        "css_var": "--text-disabled",
        "legacy_alias": "--tx-dis",
        "description": "Disabled state text"
      },
      "inverse": {
        "light": "#f7f8f8",
        "dark": "#121213",
        "css_var": "--text-inverse",
        "legacy_alias": "--tx-inv",
        "description": "Inverse text — text on dark or colored surfaces"
      }
    }
  },
  "primitives_used": {
    "vg-50": "#f7f8f8",
    "vg-75": "#f3f4f5",
    "vg-300": "#d0d3d6",
    "vg-500": "#b0b6bb",
    "vg-600": "#8d9296",
    "vg-700": "#6a6d70",
    "vg-750": "#585b5e",
    "vg-950": "#121213"
  }
}
